    "FAQ.description.item01.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SaltScan is an app designed to help you check the sodium content in food products by scanning the product's barcode. It allows you to make informed choices about the products you consume."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SaltScan est une application conçue pour vous aider à vérifier la teneur en sodium des produits alimentaires en scannant le code-barres du produit. Elle vous permet de faire des choix éclairés concernant les produits que vous consommez."
          }
        }
      }
    },
    "FAQ.description.item01.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is SaltScan?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu’est-ce que SaltScan ?"
          }
        }
      }
    },
    "FAQ.description.item02.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No, SaltScan does not require you to create an account. You can use the app without signing in."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non, SaltScan ne nécessite pas la création d’un compte. Vous pouvez utiliser l’application sans vous connecter."
          }
        }
      }
    },
    "FAQ.description.item02.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do I need to create an account to use SaltScan?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois-je créer un compte pour utiliser SaltScan ?\n"
          }
        }
      }
    },
    "FAQ.description.item03.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SaltScan requests access to your camera solely to scan food products. We do not collect or store any images or personal data from your camera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SaltScan demande l’accès à votre caméra uniquement pour scanner les produits alimentaires. Nous ne collectons ni ne stockons aucune image ni donnée personnelle provenant de votre caméra."
          }
        }
      }
    },
    "FAQ.description.item03.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why does SaltScan request access to my camera?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi SaltScan demande-t-il l’accès à ma caméra ?"
          }
        }
      }
    },
    "FAQ.description.item04.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No, SaltScan does not collect any personal information. The app only uses your camera to scan products, and no data is shared or stored."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non, SaltScan ne collecte aucune donnée personnelle. L’application utilise uniquement votre caméra pour scanner les produits, et aucune donnée n’est partagée ou stockée."
          }
        }
      }
    },
    "FAQ.description.item04.title" : {
      "extractionState" : "manual",
      "localizations" : {
