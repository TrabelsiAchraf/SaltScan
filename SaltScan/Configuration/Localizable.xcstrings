    "article03.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملح مخفي في أطعمتك المفضلة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden salt in your favorite foods"
          }
        },
