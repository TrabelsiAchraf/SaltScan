    "settings.goal.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO recommends no more than 5 g of salt per day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’OMS recommande de ne pas dépasser 5 g de sel par jour."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توصي منظمة الصحة العالمية بعدم تجاوز 5 غرامات من الملح يوميًا."
          }
        }
      }
    },
    "settings.goal.footer.sodium": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القيمة اليومية حسب FDA هي 2300 ملغ من الصوديوم. توصي منظمة الصحة العالمية بالبقاء تحت 2000 ملغ، أي 5 غ من الملح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The FDA daily value is 2,300 mg of sodium. The WHO recommends staying under 2,000 mg, which is 5 g of salt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur quotidienne FDA est de 2 300 mg de sodium. L'OMS recommande de rester sous 2 000 mg, soit 5 g de sel."
          }
        }
      }
    },
