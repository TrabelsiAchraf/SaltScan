    "settings.health.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ كل حصة من يومياتك كصوديوم غذائي. لا يقرأ Salt Scan بيانات الصحة أبدًا. عند الإيقاف يبقى ما حُفظ في تطبيق الصحة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each journal portion is saved as dietary sodium. Salt Scan never reads your Health data. Turning this off keeps what is already in Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque portion du journal est enregistrée comme sodium alimentaire. Salt Scan ne lit jamais vos données Santé. Désactiver l'option conserve ce qui est déjà dans Santé."
          }
        }
      }
    },
