    "FAQ.description.item07.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a product is not found in our database, you can manually enter the information. We are continuously updating the database to include more products."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un produit n’est pas trouvé dans notre base de données, vous pouvez entrer manuellement les informations. Nous mettons constamment à jour la base de données pour inclure plus de produits."
          }
        }
      }
    },
