    "detail.data.impossible": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيمة الصوديوم على Open Food Facts تتجاوز ما يحتويه الملح الخالص، لذا تم إخفاؤها. تحقق من الملصق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sodium value on Open Food Facts is above what pure salt contains, so it is hidden. Check the label."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur de sodium sur Open Food Facts dépasse celle du sel pur, elle est donc masquée. Vérifiez l'étiquette."
          }
        }
      }
    },
