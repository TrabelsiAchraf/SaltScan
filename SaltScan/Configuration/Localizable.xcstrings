{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "FAQ.description.item01.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SaltScan هو تطبيق مصمم لمساعدتك في التحقق من محتوى الصوديوم في المنتجات الغذائية من خلال مسح رمز المنتج. يتيح لك اتخاذ خيارات مستنيرة بشأن المنتجات التي تستهلكها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SaltScan is an app designed to help you check the sodium content in food products by scanning the product's barcode. It allows you to make informed choices about the products you consume."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SaltScan est une application conçue pour vous aider à vérifier la teneur en sodium des produits alimentaires en scannant le code-barres du produit. Elle vous permet de faire des choix éclairés concernant les produits que vous consommez."
          }
        }
      }
    },
    "FAQ.description.item01.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هو SaltScan؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is SaltScan?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu’est-ce que SaltScan ?"
          }
        }
      }
    },
    "FAQ.description.item02.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا، لا يتطلب SaltScan منك إنشاء حساب. يمكنك استخدام التطبيق دون تسجيل الدخول."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No, SaltScan does not require you to create an account. You can use the app without signing in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non, SaltScan ne nécessite pas la création d’un compte. Vous pouvez utiliser l’application sans vous connecter."
          }
        }
      }
    },
    "FAQ.description.item02.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أحتاج إلى إنشاء حساب لاستخدام SaltScan؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do I need to create an account to use SaltScan?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois-je créer un compte pour utiliser SaltScan ?\n"
          }
        }
      }
    },
    "FAQ.description.item03.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطلب SaltScan الوصول إلى كاميرتك فقط لماسح المنتجات الغذائية. نحن لا نجمع أو نخزن أي صور أو بيانات شخصية من كاميرتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SaltScan requests access to your camera solely to scan food products. We do not collect or store any images or personal data from your camera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SaltScan demande l’accès à votre caméra uniquement pour scanner les produits alimentaires. Nous ne collectons ni ne stockons aucune image ni donnée personnelle provenant de votre caméra."
          }
        }
      }
    },
    "FAQ.description.item03.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا يطلب SaltScan الوصول إلى كاميرتي؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why does SaltScan request access to my camera?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi SaltScan demande-t-il l’accès à ma caméra ?"
          }
        }
      }
    },
    "FAQ.description.item04.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا، SaltScan لا تجمع أي معلومات شخصية. التطبيق يستخدم كاميرتك فقط لمسح المنتجات، ولا يتم مشاركة البيانات أو تخزينها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No, SaltScan does not collect any personal information. The app only uses your camera to scan products, and no data is shared or stored."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non, SaltScan ne collecte aucune donnée personnelle. L’application utilise uniquement votre caméra pour scanner les produits, et aucune donnée n’est partagée ou stockée."
          }
        }
      }
    },
    "FAQ.description.item04.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يتم جمع بياناتي الشخصية بواسطة SaltScan؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is my personal data collected by SaltScan?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes données personnelles sont-elles collectées par SaltScan ?\n"
          }
        }
      }
    },
    "FAQ.description.item05.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تعطيل الوصول إلى الكاميرا في أي وقت من خلال الذهاب إلى إعدادات جهازك وإيقاف الوصول إلى الكاميرا لتطبيق SaltScan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can disable camera access at any time by going to your device’s settings and turning off camera access for the SaltScan app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez désactiver l’accès à la caméra à tout moment en vous rendant dans les paramètres de votre appareil et en désactivant l’accès à la caméra pour l’application SaltScan."
          }
        }
      }
    },
    "FAQ.description.item05.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف يمكنني تعطيل الوصول إلى الكاميرا في SaltScan؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How can I disable camera access in SaltScan?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment puis-je désactiver l’accès à la caméra dans SaltScan ?\n"
          }
        }
      }
    },
    "FAQ.description.item06.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعتمد دقة البيانات على الرمز الشريطي للمنتج والمعلومات المتاحة في قاعدة بياناتنا. نسعى لتقديم معلومات دقيقة، لكننا نوصي بالتحقق من الملصقات للتأكيد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accuracy of the data depends on the product’s barcode and the information available in our database. We strive to provide accurate information, but we recommend checking labels for confirmation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exactitude des données dépend du code-barres du produit et des informations disponibles dans notre base de données. Nous nous efforçons de fournir des informations précises, mais nous recommandons de vérifier les étiquettes pour confirmation."
          }
        }
      }
    },
    "FAQ.description.item06.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما مدى دقة المعلومات المقدمة من SaltScan؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How accurate is the information provided by SaltScan?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle est l’exactitude des informations fournies par SaltScan ?\n"
          }
        }
      }
    },
    "FAQ.description.item07.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم يتم العثور على منتج، يمكنك البحث عنه بالاسم من الشاشة الرئيسية، أو إضافته إلى Open Food Facts، قاعدة البيانات المفتوحة التي يعتمد عليها Salt Scan. تظهر المنتجات الجديدة عادةً خلال يوم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a product is not found, you can search it by name from the Home screen, or add it to Open Food Facts, the open database Salt Scan relies on. New products usually appear within a day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un produit n'est pas trouvé, vous pouvez le rechercher par son nom depuis l'accueil, ou l'ajouter sur Open Food Facts, la base ouverte utilisée par Salt Scan. Les nouveaux produits apparaissent en général sous un jour."
          }
        }
      }
    },
    "FAQ.description.item07.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يمكنني مسح المنتجات التي ليست في قاعدة البيانات؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I scan products that are not in the database?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis-je scanner des produits qui ne sont pas dans la base de données ?\n"
          }
        }
      }
    },
    "FAQ.description.item08.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كانت لديك أي أسئلة أو تحتاج إلى دعم، يمكنك الاتصال بنا على [اتصل بنا]."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have any questions or need support, you can contact us at [Contact Us]."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez des questions ou avez besoin de support, vous pouvez nous contacter à [Contactez-nous]."
          }
        }
      }
    },
    "FAQ.description.item08.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف أستطيع الاتصال بدعم العملاء؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I contact customer support?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment contacter le support client ?\n"
          }
        }
      }
    },
    "FAQ.description.item09.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوفر Salt Scan باللغات الإنجليزية والفرنسية والعربية، ويتبع لغة جهازك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt Scan is available in English, French and Arabic, and follows your device language."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt Scan est disponible en anglais, français et arabe, et suit la langue de votre appareil."
          }
        }
      }
    },
    "FAQ.description.item09.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يتوفر SaltScan بعدة لغات؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is SaltScan available in multiple languages?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SaltScan est-il disponible en plusieurs langues ?\n"
          }
        }
      }
    },
    "FAQ.description.item10.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نعم، يمكنك اقتراح منتج ليتم إضافته عن طريق الاتصال بفريق الدعم لدينا على [اتصل بنا]. نحن نراجع جميع الاقتراحات بانتظام."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, you can suggest a product to be added by contacting our support team at [Contact Us]. We review all suggestions regularly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, vous pouvez suggérer un produit à ajouter en contactant notre équipe de support à [Contactez-nous]. Nous examinons régulièrement toutes les suggestions."
          }
        }
      }
    },
    "FAQ.description.item10.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يمكنني طلب إضافة منتج إلى قاعدة البيانات؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I request to add a product to the database?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis-je demander l’ajout d’un produit dans la base de données ?\n"
          }
        }
      }
    },
