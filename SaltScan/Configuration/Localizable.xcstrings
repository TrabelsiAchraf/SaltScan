    "detail.data.suspicious.high": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوديوم أعلى بكثير من المعتاد لهذا النوع من المنتجات. أحيانًا يُدخل المساهمون الملليغرامات كغرامات. تحقق من الملصق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Far too much sodium for this kind of product. Contributors sometimes type milligrams as grams. Check the label before trusting it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaucoup trop de sodium pour ce type de produit. Des contributeurs saisissent parfois des milligrammes en grammes. Vérifiez l'étiquette."
          }
        }
      }
    },
    "detail.data.suspicious.low": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد صوديوم تقريبًا لطعام معالج. قد تكون القيمة أقل بألف مرة. تحقق من الملصق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost no sodium for a processed food. The value may be 1,000 times too small. Check the label."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque pas de sodium pour un aliment transformé. La valeur est peut-être 1 000 fois trop petite. Vérifiez l'étiquette."
          }
        }
      }
    },
